{
  "name": "vinay-engineering-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test scripts/public-policy.test.mjs",
    "typecheck": "tsc --noEmit",
    "sync:demos": "node scripts/sync-demos.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:models": "node --test projects/fpga-pwm-fan-controller/model.test.js projects/plc-hmi-sorting-machine/model.test.js",
    "check:repo": "node scripts/check-repo.mjs",
    "check:history": "node scripts/check-history.mjs",
    "diagrams": "node scripts/render-flowcharts.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "mermaid": "^12.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
